# --- Gemini AI (Google GenAI SDK) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_USE_SEARCH_GROUNDING=true

# --- Telegram Bot (Remote Control from Android) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated numeric Telegram user IDs allowed to control this bot (get yours via @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- MT5 Common Files Bridge ---
# Leave blank to auto-detect %APPDATA%\MetaQuotes\Terminal\Common\Files\EA-LearningX
MT5_COMMON_FILES_DIR=

# --- Bot Behavior & Safety ---
# Execution mode on startup: auto | confirm | pause
DEFAULT_EXECUTION_MODE=confirm
ANALYSIS_INTERVAL_MINUTES=30
SIGNAL_TTL_MINUTES=45
MIN_CONFIDENCE=0.70
MIN_RR_RATIO=1.8
MIN_CONFLUENCE_SCORE=4
REQUIRE_KILLZONE=true
ALLOW_COUNTER_H4=false

# Exness HMR (High Margin Requirements) news guard in minutes
HMR_PRE_NEWS_MINUTES=15
HMR_POST_NEWS_MINUTES=10

# Optional NewsAPI / Finnhub keys (free RSS + ForexFactory calendar work without extra keys)
FINNHUB_API_KEY=
